{
  "name": "cifar10-imagenet-r18",
  "dataset": {
    "name": "cifar10",
    "prior_fraction": 0.0,
    "number_classes": 10
  },
  "encoder": {
    "name": "imagenet_resnet18",
    "feature_dimension": 512,
    "width": 1,
    "dropout": 0.0
  },
  "prior": {
    "source": "upstream",
    "optimizer": "sgd",
    "epochs": 0,
    "batch_size": 256,
    "learning_rate": 0.1,
    "weight_decay": 0.0,
    "momentum": 0.9,
    "warmup_epochs": 0,
    "calibration_fraction": 0.0,
    "label_smoothing": 0.0,
    "augmentation": "none",
    "cutout_size": 0
  },
  "feature_map": {
    "kind": "upstream_pca",
    "rank": 128,
    "kappa": 1.0
  },
  "posterior": {
    "steps": 8000,
    "checkpoint_every": 250,
    "batch_size": 1024,
    "learning_rates": [0.003],
    "objectives": ["exact"],
    "warmup_steps": 0,
    "training_quadrature_order": 32,
    "selection_quadrature_order": 256,
    "selection_chunk_size": 256,
    "gradient_clip_norm": 10.0
  },
  "confidence": {
    "total_failure_probability": 0.05,
    "pac_bayes_delta_each": 0.045,
    "pac_bayes_family_count": 1,
    "monte_carlo_delta": 0.005,
    "direct_holdout_delta": 0.05
  },
  "certification": {
    "monte_carlo_trials": 5000000,
    "monte_carlo_chunk_size": 20000,
    "diagnostic_quadrature_order": 256,
    "evaluate_test": true,
    "direct_holdout": false
  },
  "numerics": {
    "minimum_posterior_std": 0.0001,
    "minimum_relative_singular_value": 1e-10
  }
}
