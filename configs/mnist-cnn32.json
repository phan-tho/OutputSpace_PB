{
  "name": "mnist-cnn32",
  "dataset": {
    "name": "mnist",
    "prior_fraction": 0.5,
    "number_classes": 10
  },
  "encoder": {
    "name": "mnist_cnn",
    "feature_dimension": 32,
    "width": 32,
    "dropout": 0.0
  },
  "prior": {
    "source": "a_trained",
    "optimizer": "adamw",
    "epochs": 20,
    "batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "calibration_fraction": 0.0,
    "label_smoothing": 0.0,
    "augmentation": "none",
    "cutout_size": 0
  },
  "feature_map": {
    "kind": "standardize",
    "rank": 32,
    "kappa": 0.02
  },
  "posterior": {
    "steps": 100,
    "checkpoint_every": 20,
    "batch_size": 12000,
    "learning_rates": [0.01],
    "objectives": ["exact"],
    "warmup_steps": 0,
    "training_quadrature_order": 32,
    "selection_quadrature_order": 64,
    "selection_chunk_size": 512,
    "gradient_clip_norm": 10.0
  },
  "confidence": {
    "total_failure_probability": 0.05,
    "pac_bayes_delta_each": 0.045,
    "pac_bayes_family_count": 1,
    "monte_carlo_delta": 0.005,
    "direct_holdout_delta": 0.05
  },
  "certification": {
    "monte_carlo_trials": 5000000,
    "monte_carlo_chunk_size": 20000,
    "diagnostic_quadrature_order": 96,
    "evaluate_test": true,
    "direct_holdout": true
  },
  "numerics": {
    "minimum_posterior_std": 0.0001,
    "minimum_relative_singular_value": 1e-10
  }
}
